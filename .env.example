# Copy to .env. Never commit real credentials. API and database timestamps use UTC.
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=3000
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn,tower_http=info
REQUEST_TIMEOUT_SECS=30
SHUTDOWN_TIMEOUT_SECS=45
BODY_LIMIT_BYTES=65536
PASSWORD_HASH_CONCURRENCY=4
AUTH_REQUESTS_PER_MINUTE=20

# Runtime driver: postgres | mysql. It must also be compiled into the binary.
DB_DRIVER=postgres
DATABASE_URL=postgres://rust_api:local-development-only@127.0.0.1:5432/rust_api
# MySQL alternative:
# DATABASE_URL=mysql://rust_api:local-development-only@127.0.0.1:3306/rust_api
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
DB_IDLE_TIMEOUT_SECS=300

# Optional application cache: none | redis. Independent from QUEUE_DRIVER.
CACHE_DRIVER=none
REDIS_URL=
# For local Redis: REDIS_URL=redis://127.0.0.1:6379/0
# TLS/ACL example: REDIS_URL=rediss://USERNAME:PASSWORD@redis.example:6379/0
# URL-encode credentials; query parameters and fragments are rejected.
CACHE_PREFIX=rust-api-skeleton:cache:
CACHE_DEFAULT_TTL_SECS=300
CACHE_TIMEOUT_MS=500
CACHE_MAX_VALUE_BYTES=1048576

# REQUIRED: generate with `openssl rand -hex 32`. The placeholder fails validation.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_ISSUER=rust-api-skeleton
JWT_AUDIENCE=rust-api-clients
JWT_TTL_SECS=900

# Empty disables cross-origin browser access. No wildcard, path, or trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Queue transport: database | redis. Domain writes and durable jobs remain atomic.
QUEUE_DRIVER=database
# Maximum in-flight jobs per worker process (1..64).
QUEUE_CONCURRENCY=1
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_VISIBILITY_TIMEOUT_SECS=90
QUEUE_JOB_TIMEOUT_SECS=30
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BASE_SECS=5
# Required only for QUEUE_DRIVER=redis. Keep queue Redis separate from the cache.
QUEUE_REDIS_URL=
# Local queue profile: QUEUE_REDIS_URL=redis://127.0.0.1:6380/0
# TLS/ACL: rediss://USERNAME:PASSWORD@queue.example:6379/0
QUEUE_REDIS_PREFIX=rust-api-skeleton:queue:v1
QUEUE_REDIS_TIMEOUT_MS=2000
# Redis worker includes the outbox relay by default. Set false when running
# `make relay` / the relay service separately. Database workers ignore this flag.
QUEUE_RELAY_ENABLED=true
# Seconds, minutes, hours, day-of-month, month, day-of-week; UTC.
SCHEDULER_MAINTENANCE_CRON="0 */5 * * * *"
SCHEDULER_RETENTION_DAYS=7

# log is for local development: it does NOT deliver email.
# APP_ENV=production requires smtp. Port 465 uses TLS, other ports require STARTTLS.
MAIL_TRANSPORT=log
MAIL_FROM="Rust API <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Local Compose settings. These defaults are for disposable development databases.
DB_FEATURES=postgres,mysql
POSTGRES_PASSWORD=local-development-only
MYSQL_PASSWORD=local-development-only
MYSQL_ROOT_PASSWORD=local-root-only
DOCKER_DATABASE_URL=postgres://rust_api:local-development-only@postgres:5432/rust_api
# MySQL Docker alternative:
# DOCKER_DATABASE_URL=mysql://rust_api:local-development-only@mysql:3306/rust_api
# Optional Redis profile uses this hostname; replace for an external Redis server.
DOCKER_REDIS_URL=redis://redis:6379/0
# Separate persistent Redis queue profile, or an external queue Redis endpoint.
DOCKER_QUEUE_REDIS_URL=redis://redis-queue:6379/0
